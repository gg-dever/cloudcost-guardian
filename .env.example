# AWS CloudCost Guardian - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_ACCOUNT_ID=

# ============================================
# DynamoDB Tables
# ============================================
# Table 1: Historical cost data (PK: date, SK: service_name)
COST_HISTORY_TABLE=cost_history

# Table 2: Detected anomalies (PK: anomaly_type, SK: detection_date)
ANOMALIES_TABLE=cost_anomalies

# Table 3: Cost optimization recommendations (PK: recommendation_type, SK: generated_date)
RECOMMENDATIONS_TABLE=cost_recommendations

# ============================================
# SNS Configuration
# ============================================
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:cloudcost-alerts
NOTIFICATION_EMAIL=your-email@example.com

# ============================================
# Cost Thresholds & Alerts
# ============================================
DAILY_COST_THRESHOLD=100
MONTHLY_COST_THRESHOLD=3000
COST_THRESHOLD_PERCENT=20
ALERT_ON_FORECAST_EXCEED=true

# Anomaly Detection Settings
ANOMALY_HIGH_THRESHOLD=50  # % increase for HIGH severity
ANOMALY_MEDIUM_THRESHOLD=20  # % increase for MEDIUM severity

# ============================================
# S3 Configuration
# ============================================
DASHBOARD_BUCKET=cloudcost-guardian-dashboard
LAMBDA_PACKAGE_BUCKET=cloudcost-lambda-packages

# ============================================
# Lambda Configuration
# ============================================
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=300
LAMBDA_RUNTIME=python3.9

# ============================================
# Project Configuration
# ============================================
PROJECT_NAME=cloudcost-guardian
ENVIRONMENT=dev
LOG_LEVEL=INFO
